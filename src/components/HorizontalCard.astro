---
const { 
  title, 
  img, 
  desc, 
  url, 
  badge, 
  tags, 
  target = "_blank", 
  embedUrl,
  company,
  details = []
} = Astro.props;
import { Image } from "astro:assets";
const tag_url = url && !embedUrl ? url.split("/").slice(0, -1).join("/") + "/tag" : "";
---

<div
  class={`rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%] ${embedUrl ? 'w-full' : ''}`}
>
  {embedUrl ? (
    <div class="w-full">
      <div class="p-4 md:p-5">
        <h1 class="text-xl md:text-2xl font-bold mb-2 md:mb-3">
          {title}
          {badge && <div class="badge badge-secondary mx-2 text-xs">{badge}</div>}
        </h1>
        <p class="text-base md:text-lg mb-4 md:mb-5 line-clamp-3">{desc}</p>
      </div>
      <div class="w-full mb-0">
        <iframe
          src={embedUrl}
          width="100%"
          height="450"
          frameborder="0"
          allowFullScreen="true"
          class="rounded-lg">
        </iframe>
      </div>
    </div>
  ) : (
    <a href={url} target={target}>
      <div class="hero-content flex-col md:flex-row gap-3 md:gap-4 p-3 md:p-4">
        {
          img && (
            <Image
              src={img}
              width={500}
              height={300}
              format="webp"
              alt={title}
              class="max-w-full md:max-w-[10rem] lg:max-w-[12rem] rounded-lg flex-shrink-0"
            />
          )
        }
        <div class="grow w-full min-w-0">
          <h1 class="text-lg md:text-xl font-bold break-words">
            {title}
            {badge && <div class="badge badge-secondary mx-2 text-xs">{badge}</div>}
          </h1>
          {company && <p class="text-sm font-semibold text-gray-600 mb-1">{company}</p>}
          <p class="py-1 text-sm md:text-base mb-2 line-clamp-2">{desc}</p>
          {details && details.length > 0 && (
            <ul class="list-disc list-inside text-xs md:text-sm space-y-0.5 mb-2 text-gray-700">
              {details.map((detail) => (
                <li>{detail}</li>
              ))}
            </ul>
          )}
          <div class="card-actions justify-start gap-1 flex-wrap">
            {
              tags &&
                tags.map((tag) => (
                  <a href={`${tag_url}/${tag}`} class="badge badge-outline badge-sm text-xs">
                    {tag}
                  </a>
                ))
            }
          </div>
        </div>
      </div>
    </a>
  )}
</div>
