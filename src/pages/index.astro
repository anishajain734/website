---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Anisha Jain</div>
    <div class="text-3xl py-3 font-bold">Data Analyst and Microsoft PL 300 Power BI certified</div>
    <div class="py-2">
      <text class="text-lg">
        Thanks for visiting my website. Here you can find my experience and projects that I've worked on.
      </text>
    </div>
    <div class="mt-4">
      <a class="btn" href="resume/anisha-resume.pdf" target="_blank">Resume</a>
    </div>
  </div>

  <div class="mt-6 w-full">
    <div class="text-3xl w-full font-bold mb-4">Education</div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 mb-6">
      <div class="p-3 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
        <h3 class="text-lg font-bold text-primary mb-1">Certificate in Data Analytics</h3>
        <p class="text-sm font-semibold">University of Washington</p>
      </div>

      <div class="p-3 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
        <h3 class="text-lg font-bold text-primary">Microsoft Power BI (PL-300) Certified</h3>
      </div>

      <div class="p-3 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
        <h3 class="text-lg font-bold text-primary mb-1">PhD in General Management</h3>
        <p class="text-sm font-semibold">IIS University, India</p>
      </div>

      <div class="p-3 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
        <h3 class="text-lg font-bold text-primary mb-1">MBA in International Business</h3>
        <p class="text-sm font-semibold">IIS University, India</p>
      </div>

      <div class="p-3 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
        <h3 class="text-lg font-bold text-primary mb-1">Bachelor of Commerce</h3>
        <p class="text-sm font-semibold">Accounting & Taxation</p>
      </div>
    </div>
  </div>

  <div class="mt-6 w-full" id="professional-experience">
    <div class="text-3xl w-full font-bold mb-4">Professional Experience</div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6">
      <!-- Financial Consultant - ICICI Prudential -->
      <div class="p-3 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
        <h3 class="text-lg font-bold text-primary mb-2">Financial Consultant (BI)</h3>
        <p class="text-sm font-semibold mb-2">ICICI Prudential Ltd.</p>
        <p class="text-xs text-gray-600 mb-2">Designed and developed Power BI dashboards for financial tracking across 20+ client accounts. Automated complex projections and reporting processes, improving accuracy and efficiency for the consulting team.</p>
        <ul class="list-disc list-inside space-y-0.5 text-sm">
          <li><span class="text-green-600 font-semibold">20+ client accounts</span> financial tracking & monthly reconciliation</li>
          <li><span class="text-green-600 font-semibold">3% accuracy</span> improvement in financial projections</li>
          <li><span class="text-green-600 font-semibold">~500% efficiency</span> gain via Power Query automation</li>
          <li>Created KPI dashboards for portfolio performance monitoring</li>
        </ul>
      </div>

      <!-- Assistant Professor -->
      <div class="p-3 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
        <h3 class="text-lg font-bold text-primary mb-2">Assistant Professor</h3>
        <p class="text-sm font-semibold mb-2">St. Wilfred PG College</p>
        <p class="text-xs text-gray-600 mb-2">Taught advanced courses in management and analytics while leading college accreditation initiatives. Developed innovative assessment frameworks and mentored 200+ students annually in data-driven decision making.</p>
        <ul class="list-disc list-inside space-y-0.5 text-sm">
          <li>NAAC accreditation - achieved <span class="text-green-600 font-semibold">A grade</span> (10.25/12)</li>
          <li><span class="text-green-600 font-semibold">11% improvement</span> in average course grades (semester-over-semester)</li>
          <li>Developed KPI framework for student performance & feedback analysis</li>
          <li>Mentored 50+ students in research methodology & analytics projects</li>
        </ul>
      </div>

      <!-- Customer Data Analyst -->
      <div class="p-3 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
        <h3 class="text-lg font-bold text-primary mb-2">Customer Data Analyst</h3>
        <p class="text-sm font-semibold mb-2">Kurki Heritage (Hotel & Hospitality)</p>
        <p class="text-xs text-gray-600 mb-2">Analyzed guest data and market trends to optimize revenue and occupancy. Implemented dynamic pricing strategies using predictive analytics and Power BI dashboards, leading to significant revenue growth.</p>
        <ul class="list-disc list-inside space-y-0.5 text-sm">
          <li><span class="text-green-600 font-semibold">34% YoY revenue</span> growth through pricing optimization</li>
          <li><span class="text-green-600 font-semibold">28% occupancy</span> improvement with targeted campaigns</li>
          <li>Built real-time Power BI dashboards for guest behavior & booking patterns</li>
          <li>Developed seasonal pricing strategies based on demand forecasting</li>
        </ul>
      </div>

      <!-- Data Analyst -->
      <div class="p-3 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
        <h3 class="text-lg font-bold text-primary mb-2">Data Analyst (Sales & Operations)</h3>
        <p class="text-sm font-semibold mb-2">Vedantu (EdTech)</p>
        <p class="text-xs text-gray-600 mb-2">Managed sales and operational analytics for India's largest online tutoring platform. Automated reporting processes and built multi-region dashboards to support data-driven business decisions across the organization.</p>
        <ul class="list-disc list-inside space-y-0.5 text-sm">
          <li>Revenue tracking & sales forecasting for multi-region operations</li>
          <li><span class="text-green-600 font-semibold">2x efficiency</span> improvement through Python automation</li>
          <li>Built multi-region Power BI reports for 15+ stakeholders</li>
          <li>Reduced manual reporting time from 40 to 10 hours weekly</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="mt-6 w-full" id="power-bi-dashboards">
    <div class="text-3xl w-full font-bold mb-4">Power BI Dashboards</div>
  </div>

  <HorizontalCard
    title="Blinkit Sales, Marketing & Product Analytics"
    img="/post_img.webp"
    desc="Interactive Power BI dashboard analyzing sales (11M+), customer behavior, marketing performance,
and inventory metrics using a Snowflake schema data model. Implemented advanced DAX, dynamic slicers, and drill through features to deliver real-time insights and support data-driven
decision-making."
    embedUrl="https://app.powerbi.com/view?r=eyJrIjoiOWRhZmIxNzAtMzMyYS00NjVlLWI5MWYtNGMxM2QxMzM4OTJiIiwidCI6ImY2YjZkZDViLWYwMmYtNDQxYS05OWEwLTE2MmFjNTA2MGJkMiIsImMiOjZ9&pageName=Page%203"
    badge="NEW"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Amazon India Sales Analysis"
    img="/post_img.webp"
    desc="Developed ETL pipelines using Python (Pandas) to clean and structure raw sales data.
Built Power BI dashboards for revenue and customer trends using DA."
    embedUrl="https://app.powerbi.com/view?r=eyJrIjoiNDU0YmU5MjAtMjQ0OS00ZjlkLTgyNDAtYWRkYzhiNGJmYjFmIiwidCI6ImY2YjZkZDViLWYwMmYtNDQxYS05OWEwLTE2MmFjNTA2MGJkMiIsImMiOjZ9"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="IBM Employee Distribution and Performance Analysis"
    img="/post_img.webp"
    desc="Analyzed employee distribution and performance across IBM using Power BI.
Built dashboards to visualize workforce metrics, performance trends, and operational insights."
    embedUrl="https://app.powerbi.com/view?r=eyJrIjoiNzk5YmQ4MTYtY2ZjOS00MDgwLThiY2QtNDNjMzg5MGI2NjAxIiwidCI6ImY2YjZkZDViLWYwMmYtNDQxYS05OWEwLTE2MmFjNTA2MGJkMiIsImMiOjZ9"
    badge="IBM"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Netflix Revenue & Subscriber Analytics"
    img="/post_img.webp"
    desc="Built Power BI dashboards analyzing Netflix revenue and subscriber trends.
Used data visualization to uncover growth drivers and retention patterns across markets."
    embedUrl="https://app.powerbi.com/view?r=eyJrIjoiYzViMWM1ZjctYjQ2Mi00OGVkLTg5ZjUtNDgxZWI1MTBjM2Y1IiwidCI6ImY2YjZkZDViLWYwMmYtNDQxYS05OWEwLTE2MmFjNTA2MGJkMiIsImMiOjZ9"
    badge="NETFLIX"
  />
  <div class="divider my-0"></div>
</BaseLayout>
