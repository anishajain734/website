---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Anisha Jain</div>
    <div class="text-3xl py-3 font-bold">Data Analyst and Microsoft PL 300 Power BI certified</div>
    <div class="py-2">
      <text class="text-lg">
        Thanks for visiting my website. Here you can find my experience and projects that I've worked on.
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="https://github.com/anishajain734/website" target="_blank">Resume</a>
    </div>
  </div>

  <div class="mt-12">
    <div class="text-3xl w-full font-bold mb-6">Professional Experience</div>
    
    <!-- Financial Consultant - ICICI Prudential -->
    <div class="mb-6 p-4 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
      <div class="flex flex-col md:flex-row md:justify-between md:items-start mb-2">
        <div>
          <h3 class="text-xl font-bold text-primary">Financial Consultant (BI)</h3>
          <p class="text-lg font-semibold">ICICI Prudential Ltd.</p>
        </div>
        <span class="badge badge-neutral">09/2024 – 10/2024</span>
      </div>
      <ul class="list-disc list-inside space-y-2 text-base">
        <li>Built Power BI dashboards tracking financial performance of 20+ client accounts (worth $XM) with quarterly reporting across index funds, mutual funds, and fixed deposits</li>
        <li>Calculated projected growth scenarios using Advanced Excel analysis, achieving 3% accuracy delta within projected range</li>
        <li>Improved operational efficiency by ~800% through SQL-automated dashboards (6-7 hours → 1 hour)</li>
      </ul>
    </div>

    <!-- Assistant Professor -->
    <div class="mb-6 p-4 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
      <div class="flex flex-col md:flex-row md:justify-between md:items-start mb-2">
        <div>
          <h3 class="text-xl font-bold text-primary">Assistant Professor</h3>
          <p class="text-lg font-semibold">St. Wilfred PG College</p>
        </div>
        <span class="badge badge-neutral">12/2023 - 02/2024</span>
      </div>
      <ul class="list-disc list-inside space-y-2 text-base">
        <li>Led data analysis for college student grades across disciplines for NAAC accreditation (achieved A grade)</li>
        <li>Developed Excel dashboard for performance trends and growth opportunities across courses</li>
        <li>Achieved 11% improvement in average accounting course grade through KPI metrics framework</li>
      </ul>
    </div>

    <!-- Customer Data Analyst - Kurki Heritage -->
    <div class="mb-6 p-4 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
      <div class="flex flex-col md:flex-row md:justify-between md:items-start mb-2">
        <div>
          <h3 class="text-xl font-bold text-primary">Customer Data Analyst</h3>
          <p class="text-lg font-semibold">Kurki Heritage (Hotel & Hospitality)</p>
        </div>
        <span class="badge badge-neutral">08/2022 – 09/2023</span>
      </div>
      <ul class="list-disc list-inside space-y-2 text-base">
        <li>Built Power BI dashboards analyzing hotel booking revenue seasonality to establish dynamic pricing</li>
        <li>Analyzed competitor pricing strategies using SQL and Excel for weekly price adjustments</li>
        <li>Achieved 34% YoY revenue growth and 28% occupancy rate improvement through data-driven pricing</li>
      </ul>
    </div>

    <!-- Data Analyst - Vedantu -->
    <div class="mb-6 p-4 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
      <div class="flex flex-col md:flex-row md:justify-between md:items-start mb-2">
        <div>
          <h3 class="text-xl font-bold text-primary">Data Analyst (Sales & Operations)</h3>
          <p class="text-lg font-semibold">Vedantu (EdTech)</p>
        </div>
        <span class="badge badge-neutral">06/2021 – 08/2021</span>
      </div>
      <ul class="list-disc list-inside space-y-2 text-base">
        <li>Built Excel dashboards tracking revenue growth and sales forecasting by geography and quarters</li>
        <li>Automated weekly sales report generation and distribution across regions</li>
        <li>Improved operational efficiency by 2x through automation</li>
      </ul>
    </div>
  </div>

  <div class="mt-12">
    <div class="text-3xl w-full font-bold mb-2">Power BI Dashboards</div>
  </div>

  <HorizontalCard
    title="Blinkit Sales, Marketing & Product Analytics"
    img="/post_img.webp"
    desc="Interactive Power BI dashboard analyzing sales (11M+), customer behavior, marketing performance,
and inventory metrics using a Snowflake schema data model. Implemented advanced DAX, dynamic slicers, and drill through features to deliver real-time insights and support data-driven
decision-making."
    embedUrl="https://app.powerbi.com/view?r=eyJrIjoiOWRhZmIxNzAtMzMyYS00NjVlLWI5MWYtNGMxM2QxMzM4OTJiIiwidCI6ImY2YjZkZDViLWYwMmYtNDQxYS05OWEwLTE2MmFjNTA2MGJkMiIsImMiOjZ9&pageName=Page%203"
    badge="NEW"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Amazon India Sales Analysis"
    img="/post_img.webp"
    desc="Developed ETL pipelines using Python (Pandas) to clean and structure raw sales data.
Built Power BI dashboards for revenue and customer trends using DA."
    embedUrl="https://app.powerbi.com/view?r=eyJrIjoiNDU0YmU5MjAtMjQ0OS00ZjlkLTgyNDAtYWRkYzhiNGJmYjFmIiwidCI6ImY2YjZkZDViLWYwMmYtNDQxYS05OWEwLTE2MmFjNTA2MGJkMiIsImMiOjZ9"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="IBM Employee Distribution and Performance Analysis"
    img="/post_img.webp"
    desc="Analyzed employee distribution and performance across IBM using Power BI.
Built dashboards to visualize workforce metrics, performance trends, and operational insights."
    embedUrl="https://app.powerbi.com/view?r=eyJrIjoiNzk5YmQ4MTYtY2ZjOS00MDgwLThiY2QtNDNjMzg5MGI2NjAxIiwidCI6ImY2YjZkZDViLWYwMmYtNDQxYS05OWEwLTE2MmFjNTA2MGJkMiIsImMiOjZ9"
    badge="IBM"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Netflix Revenue & Subscriber Analytics"
    img="/post_img.webp"
    desc="Built Power BI dashboards analyzing Netflix revenue and subscriber trends.
Used data visualization to uncover growth drivers and retention patterns across markets."
    embedUrl="https://app.powerbi.com/view?r=eyJrIjoiYzViMWM1ZjctYjQ2Mi00OGVkLTg5ZjUtNDgxZWI1MTBjM2Y1IiwidCI6ImY2YjZkZDViLWYwMmYtNDQxYS05OWEwLTE2MmFjNTA2MGJkMiIsImMiOjZ9"
    badge="NETFLIX"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Demo Project 2"
    img="/post_img.webp"
    desc="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
    url="#"
  />
</BaseLayout>
