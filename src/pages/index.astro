---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Anisha Jain</div>
    <div class="text-3xl py-3 font-bold">Data Analyst and Microsoft PL 300 Power BI certified</div>
    <div class="py-2">
      <text class="text-lg">
        Thanks for visiting my website. Here you can find my experience and projects that I've worked on.
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="https://github.com/anishajain734/website" target="_blank">Resume</a>
    </div>
  </div>

  <div class="mt-12">
    <div class="text-3xl w-full font-bold mb-6">Education</div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-12">
      <div class="p-4 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
        <h3 class="text-lg font-bold text-primary">Certificate in Data Analytics</h3>
        <p class="text-sm font-semibold">University of Washington</p>
      </div>

      <div class="p-4 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
        <h3 class="text-lg font-bold text-primary">Microsoft Power BI (PL-300) Certified</h3>
      </div>

      <div class="p-4 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
        <h3 class="text-lg font-bold text-primary">PhD in General Management</h3>
        <p class="text-sm font-semibold">IIS University, India</p>
      </div>

      <div class="p-4 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
        <h3 class="text-lg font-bold text-primary">MBA in International Business</h3>
        <p class="text-sm font-semibold">IIS University, India</p>
      </div>

      <div class="p-4 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
        <h3 class="text-lg font-bold text-primary">Bachelor of Commerce</h3>
        <p class="text-sm font-semibold">Accounting & Taxation</p>
      </div>
    </div>
  </div>

  <div class="mt-12">
    <div class="text-3xl w-full font-bold mb-6">Professional Experience</div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-12">
      <!-- Financial Consultant - ICICI Prudential -->
      <div class="p-4 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
        <h3 class="text-lg font-bold text-primary">Financial Consultant (BI)</h3>
        <p class="text-sm font-semibold mb-3">ICICI Prudential Ltd.</p>
        <ul class="list-disc list-inside space-y-1 text-sm">
          <li><span class="text-green-600 font-semibold">20+ client accounts</span> financial tracking</li>
          <li><span class="text-green-600 font-semibold">3% accuracy</span> in projections</li>
          <li><span class="text-green-600 font-semibold">~800% efficiency</span> gain via automation</li>
        </ul>
      </div>

      <!-- Assistant Professor -->
      <div class="p-4 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
        <h3 class="text-lg font-bold text-primary">Assistant Professor</h3>
        <p class="text-sm font-semibold mb-3">St. Wilfred PG College</p>
        <ul class="list-disc list-inside space-y-1 text-sm">
          <li>NAAC accreditation - achieved <span class="text-green-600 font-semibold">A grade</span></li>
          <li><span class="text-green-600 font-semibold">11% improvement</span> in course grades</li>
          <li>KPI framework for student performance</li>
        </ul>
      </div>

      <!-- Customer Data Analyst -->
      <div class="p-4 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
        <h3 class="text-lg font-bold text-primary">Customer Data Analyst</h3>
        <p class="text-sm font-semibold mb-3">Kurki Heritage (Hotel & Hospitality)</p>
        <ul class="list-disc list-inside space-y-1 text-sm">
          <li><span class="text-green-600 font-semibold">34% YoY revenue</span> growth</li>
          <li><span class="text-green-600 font-semibold">28% occupancy</span> improvement</li>
          <li>Dynamic pricing strategies via Power BI</li>
        </ul>
      </div>

      <!-- Data Analyst -->
      <div class="p-4 rounded-lg bg-base-100 hover:shadow-lg transition ease-in-out">
        <h3 class="text-lg font-bold text-primary">Data Analyst (Sales & Operations)</h3>
        <p class="text-sm font-semibold mb-3">Vedantu (EdTech)</p>
        <ul class="list-disc list-inside space-y-1 text-sm">
          <li>Revenue tracking & sales forecasting</li>
          <li><span class="text-green-600 font-semibold">2x efficiency</span> through automation</li>
          <li>Multi-region report distribution</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="mt-12">
    <div class="text-3xl w-full font-bold mb-2">Power BI Dashboards</div>
  </div>

  <HorizontalCard
    title="Blinkit Sales, Marketing & Product Analytics"
    img="/post_img.webp"
    desc="Interactive Power BI dashboard analyzing sales (11M+), customer behavior, marketing performance,
and inventory metrics using a Snowflake schema data model. Implemented advanced DAX, dynamic slicers, and drill through features to deliver real-time insights and support data-driven
decision-making."
    embedUrl="https://app.powerbi.com/view?r=eyJrIjoiOWRhZmIxNzAtMzMyYS00NjVlLWI5MWYtNGMxM2QxMzM4OTJiIiwidCI6ImY2YjZkZDViLWYwMmYtNDQxYS05OWEwLTE2MmFjNTA2MGJkMiIsImMiOjZ9&pageName=Page%203"
    badge="NEW"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Amazon India Sales Analysis"
    img="/post_img.webp"
    desc="Developed ETL pipelines using Python (Pandas) to clean and structure raw sales data.
Built Power BI dashboards for revenue and customer trends using DA."
    embedUrl="https://app.powerbi.com/view?r=eyJrIjoiNDU0YmU5MjAtMjQ0OS00ZjlkLTgyNDAtYWRkYzhiNGJmYjFmIiwidCI6ImY2YjZkZDViLWYwMmYtNDQxYS05OWEwLTE2MmFjNTA2MGJkMiIsImMiOjZ9"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="IBM Employee Distribution and Performance Analysis"
    img="/post_img.webp"
    desc="Analyzed employee distribution and performance across IBM using Power BI.
Built dashboards to visualize workforce metrics, performance trends, and operational insights."
    embedUrl="https://app.powerbi.com/view?r=eyJrIjoiNzk5YmQ4MTYtY2ZjOS00MDgwLThiY2QtNDNjMzg5MGI2NjAxIiwidCI6ImY2YjZkZDViLWYwMmYtNDQxYS05OWEwLTE2MmFjNTA2MGJkMiIsImMiOjZ9"
    badge="IBM"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Netflix Revenue & Subscriber Analytics"
    img="/post_img.webp"
    desc="Built Power BI dashboards analyzing Netflix revenue and subscriber trends.
Used data visualization to uncover growth drivers and retention patterns across markets."
    embedUrl="https://app.powerbi.com/view?r=eyJrIjoiYzViMWM1ZjctYjQ2Mi00OGVkLTg5ZjUtNDgxZWI1MTBjM2Y1IiwidCI6ImY2YjZkZDViLWYwMmYtNDQxYS05OWEwLTE2MmFjNTA2MGJkMiIsImMiOjZ9"
    badge="NETFLIX"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Demo Project 2"
    img="/post_img.webp"
    desc="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
    url="#"
  />
</BaseLayout>
